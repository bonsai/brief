{
  "imports": {
    "@zod/zod":          "jsr:@zod/zod@^4",
    "@std/cli":          "jsr:@std/cli@^1",
    "@std/path":         "jsr:@std/path@^1",
    "@std/assert":       "jsr:@std/assert@^1",
    "react":             "npm:react@18",
    "react/jsx-runtime": "npm:react@18/jsx-runtime",
    "ink":               "npm:ink@5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "types": ["npm:@types/react@18"]
  },
  "tasks": {
    "brief":    "deno run --allow-read --allow-env view/render.ts",
    "tui":      "deno run --allow-read --allow-env --allow-sys view/tui.tsx",
    "validate": "deno run --allow-read --allow-env model/validate.ts",
    "schema":  "deno run --allow-read --allow-env --allow-write model/emit-schema.ts",
    "test":    "deno test -A controller/ model/ view/",
    "check":   "deno check controller/ model/ view/",
"verify":  "deno task lint && deno task check && deno task test && deno task schema -- --check",
    "lint":    "deno lint"
  }
}
